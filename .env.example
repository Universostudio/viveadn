# Copia este archivo como .env y rellena con tus credenciales Supabase
# Obtén estos valores en: https://app.supabase.com → tu proyecto → Settings → API

VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Datos del titular que aparecen en los textos legales (política de privacidad, términos, aviso legal).
# Nunca se inventan: si falta uno, el documento muestra un aviso visible. Los valores finales los confirma Gerencia.
# `npm run check:config-legal` comprueba que están todos antes de publicar.
VITE_LEGAL_TITULAR=Visualiza Studio
VITE_LEGAL_NIF=
VITE_LEGAL_DOMICILIO=
VITE_EMAIL_LEGAL=
VITE_EMAIL_SOPORTE=
# Solo si el titular está inscrito en un registro público (por ejemplo, el Mercantil); si no, se deja vacío
VITE_LEGAL_REGISTRO=
